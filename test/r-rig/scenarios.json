{
	"version-latest": {
		"image": "debian:stable-slim",
		"features": {
			"r-rig": {
				"version": "latest"
			}
		}
	},
	"version-specific-4": {
		"image": "ubuntu:noble",
		"features": {
			"r-rig": {
				"version": "4"
			}
		}
	},
	"version-specific-40": {
		"image": "ubuntu:jammy",
		"features": {
			"r-rig": {
				"version": "4.0"
			}
		}
	},
	"full": {
		"image": "debian:stable-slim",
		"features": {
			"r-rig": {
				"vscodeRSupport": "full",
				"installDevTools": true,
				"installREnv": true,
				"installRMarkdown": true,
				"arfVersion": "latest"
			}
		}
	},
	"arf-specific-version": {
		"image": "ubuntu:noble",
		"features": {
			"r-rig": {
				"arfVersion": "0.6.0"
			}
		}
	},
	"rmarkdown-with-pandoc-feature": {
		"image": "ubuntu:noble",
		"features": {
			"pandoc": {},
			"r-rig": {
				"installRMarkdown": true
			}
		}
	},
	"version-none-on-r-ver": {
		"image": "rocker/r-ver:4",
		"features": {
			"r-rig": {
				"version": "none",
				"vscodeRSupport": "lsp"
			}
		}
	},
	"non-root-user": {
		"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
		"features": {
			"r-rig": {
				"vscodeRSupport": "lsp"
			}
		}
	}
}
